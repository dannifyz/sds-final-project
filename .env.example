# Copy to .env and change every value.
HTTP_PORT=8080

# The single admin account (no database).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Long random strings, e.g. `openssl rand -hex 32`. Keep the two different.
SESSION_SECRET=replace-with-random-session-secret
TICKET_SECRET=replace-with-random-ticket-secret

# Set to true when serving over HTTPS.
COOKIE_SECURE=false
